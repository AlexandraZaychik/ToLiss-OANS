OANS_MENU(cursor_yellow_horizontal, cursor, "Yellow - Horizontal", 27)
// MCDU2 sampling contract (display labels do not change legacy INI values):
// 不会主动操作 MCDU2、翻页并产生响声的只读检测，在所有挡位都有（包括 INIT FROM/TO、ALTN）。
// [silent] basic: no active page-navigation capture.
// [a bit] light trigger: beacon OFF->ON / both landing lights OFF->ON trigger capture (5s polling; two retries).
// [annoy] mcdu trigger: former full open; preserve engine/flight-phase automatic capture and MCDU action triggers.
// Legacy fms_mcdu2_sampling stays 0=closed, 1=former full open, 2=with light; do not renumber saved settings.
OANS_MENU(mcdu2_auto, settings, "Info from mcdu2", 0)
OANS_MENU(mcdu2_full_open, mcdu2_auto, "[annoy] mcdu trigger", 28)
OANS_MENU(mcdu2_with_light, mcdu2_auto, "[a bit] light trigger", 33)
OANS_MENU(mcdu2_full_close, mcdu2_auto, "[silent] basic", 31)
OANS_MENU(traffic, settings, "Show Traffic", 29)
OANS_MENU(close_when_takeoff, settings, "Close oans when TO", 32)
OANS_MENU(language, root, "Language", 0)
OANS_MENU(language_english, language, "English", 40)
OANS_MENU(language_chinese, language, "中文", 41)
OANS_MENU(about, root, "About", 23)
OANS_MENU(test, root, "Test[develop]", 19)
