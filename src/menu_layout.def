OANS_MENU(detail_ultra, detail_quality, "Ultra", 34)
OANS_MENU(detail_max, detail_quality, "Max", 35)
OANS_MENU(detail_xhigh, detail_quality, "Xhigh", 36)
OANS_MENU(detail_high, detail_quality, "High", 37)
OANS_MENU(detail_medium, detail_quality, "Medium", 38)
OANS_MENU(detail_low, detail_quality, "Low", 39)
OANS_MENU(stand_name, settings, "Stand name", 0)
